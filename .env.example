# Copy this file to .env and fill in your values for local development.
# In production, set these in: Netlify → Site Settings → Environment Variables

# Supabase — Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Server-only key (same page, "service_role"; secret). Reads/writes the `secrets` table
# that holds the connected Instagram token (S9). Never ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend — resend.com → API Keys
RESEND_API_KEY=re_your_key_here

# Meta (Facebook / Instagram) — developers.facebook.com → App → Webhooks
META_APP_ID=your_app_id_here
META_APP_SECRET=your_app_secret_here
META_VERIFY_TOKEN=any_random_string_you_choose
# Instagram access token (IGAA…) — Instagram → API setup with Instagram login → Generate access tokens
# Fallback only since S9: a token connected through the Connect link (secrets table) wins.
META_ACCESS_TOKEN=your_instagram_access_token_here
# Connect Instagram (S9) — App → Instagram → API setup with Instagram login → Business login settings.
# IG_APP_ID / IG_APP_SECRET are the *Instagram* app id/secret shown there (not META_APP_ID).
# IG_CONNECT_CODE: any random string (A-Z a-z 0-9 _ -). The Connect link is
#   <site>/.netlify/functions/ig-connect?start=<IG_CONNECT_CODE>  — unset = connect disabled.
IG_APP_ID=
IG_APP_SECRET=
IG_CONNECT_CODE=
# Facebook PAGE access token — Messenger → Settings → Access Tokens (for inbound profile + outbound sends)
META_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
# Optional: your Facebook Page numeric id. Defaults to 'me' (resolved via the Page token). Used by FB comment automation's private reply.
# META_PAGE_ID=your_facebook_page_id_here
META_BRANCH_ID=your_branch_uuid_here

# WhatsApp Cloud API — developers.facebook.com → App → WhatsApp → API Setup
# Phone Number ID is the numeric id shown next to the number, NOT the number itself.
# The dashboard token is temporary (24h) — use a System User token with expiry Never in production.
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here

# Internal shared secret — lets the scheduled check-automations cron authorize its
# calls to send-automation-report / send-automation-webhook (now PIN/secret-gated).
# REQUIRED for scheduled automations to fire once the send endpoints are protected.
# Generate a long random string. The browser instead sends x-staff-pin (the logged-in PIN).
INTERNAL_FUNCTION_SECRET=your_random_internal_secret_here

# Gemini — Google AI Studio (aistudio.google.com → Get API key). Powers the
# Instagram DM chatbot (chatbot final plan §3.5); free tier covers shadow mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Lead push (chatbot-as-a-service S2) — a Make "Custom webhook" URL. Settled chats
# are POSTed here as lead / potential_lead. Unset = no pushes (logged). Kept in env,
# not the DB, because the DB is readable with the public key.
LEAD_WEBHOOK_URL= 
# Optional: Make webhook API key, sent as the x-make-apikey header.
# LEAD_WEBHOOK_KEY=

# Owner alerts on Telegram (chatbot-as-a-service S3). Token from @BotFather.
# WEBHOOK_SECRET: any random string (A-Z a-z 0-9 _ -), also passed to setWebhook as secret_token.
# LINK_CODE: the owner opens t.me/<bot>?start=<code> once to receive alerts (same characters, max 64).
# Unset or unlinked = alerts go by email (RESEND_API_KEY) as before.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_CODE=
